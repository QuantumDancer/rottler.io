# FROM https://github.com/github/gitignore/blob/main/Terraform.gitignore

# Local .terraform directories
**/.terraform/*

# .tfstate files — including the pre-migration snapshots taken in tmp/
*.tfstate
*.tfstate.*

# Saved plan files. These are reviewed and applied locally, never committed:
# a plan is only valid against the state it was generated from.
*.tfplan

# Crash log files
crash.log
crash.*.log

# .tfvars carry values that must not be public. Non-secret per-env values live
# in the env root's locals; a .tfvars holds only what the public repo can't
# show (envs/shared-services: the alert email address).
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc
