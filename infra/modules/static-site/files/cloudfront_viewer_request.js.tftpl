// Viewer-request function for the site's only cache behaviour. Rendered by
// Terraform's templatefile() with the canonical host; the template avoids
// JavaScript template literals so nothing here collides with Terraform's
// interpolation syntax.
//
// It does two jobs because CloudFront allows one function per event type per
// cache behaviour: the canonical-host redirect and the index.html rewrite
// cannot be split into two viewer-request functions.
var CANONICAL_HOST = "${canonical_host}";

function handler(event) {
  var request = event.request;

  // ----------------------------------------------------------------------------
  // 1. Canonical-host redirect
  // ----------------------------------------------------------------------------
  //
  // Any host other than the canonical one gets a 301 to the same path on the
  // canonical host. Keying on "not canonical" rather than on a list of
  // alternate hosts means a new alias redirects without a second list to keep
  // in step with the distribution's aliases. 301 rather than 308: the site only
  // serves GET and HEAD, so there's no request body to keep.
  //
  // This runs before the index.html rewrite so the Location carries the URI the
  // viewer asked for, not the rewritten object key.
  var host = request.headers.host ? request.headers.host.value : "";
  if (host.toLowerCase() !== CANONICAL_HOST) {
    return {
      statusCode: 301,
      statusDescription: "Moved Permanently",
      headers: {
        location: {
          value: "https://" + CANONICAL_HOST + request.uri + queryString(request.querystring),
        },
      },
    };
  }

  // ----------------------------------------------------------------------------
  // 2. index.html rewrite
  // ----------------------------------------------------------------------------
  //
  // A static site in S3 has no directory-index concept, so `/about` and
  // `/about/` become `/about/index.html`, the shape Astro's static build
  // emits. https://stackoverflow.com/a/76581267
  var uri = request.uri;

  // The URI is missing a file name.
  if (uri.endsWith("/")) {
    request.uri += "index.html";
  }
  // The URI is missing a file extension.
  else if (!uri.includes(".")) {
    request.uri += "/index.html";
  }

  return request;
}

// The event exposes the query string as an object keyed by parameter name, not
// as the raw string, so the redirect rebuilds it. Repeated parameters
// (`?tag=a&tag=b`) live in `multiValue`, which, when present, repeats the first
// value as well, so it replaces `value` rather than adding to it. A bare flag
// (`?draft`) comes back as `?draft=`, which no page on a static site can tell
// apart.
//
// Values are passed through as CloudFront presents them, without re-encoding.
// TODO: confirm on the first real alternate host (www at cutover) that a
// percent-encoded value such as `?q=a%20b` survives the redirect unchanged.
function queryString(querystring) {
  var pairs = [];
  for (var name in querystring) {
    var param = querystring[name];
    var values = param.multiValue ? param.multiValue : [param];
    for (var i = 0; i < values.length; i++) {
      pairs.push(name + "=" + values[i].value);
    }
  }
  return pairs.length > 0 ? "?" + pairs.join("&") : "";
}
