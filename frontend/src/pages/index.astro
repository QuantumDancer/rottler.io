---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/portrait.jpg';
import SocialIcon from '../components/SocialIcon.astro';
import { socialLinks } from '../data/site';
import { getPublishedPosts } from '../lib/posts';

const recentPosts = (await getPublishedPosts()).slice(0, 3);

// "Jun 14, 2026" — matches the Claude Design v1 mono date style.
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: '2-digit',
  year: 'numeric',
});
---

<BaseLayout>
  <main class="home">
    <section class="intro fade-up">
      <p class="kicker">hi, I'm Benjamin —</p>
      <h1 class="headline">
        Platform engineer building reliable, repeatable infrastructure.
      </h1>
      <Image
        src={portrait}
        alt="Portrait of Benjamin Rottler"
        width={296}
        height={296}
        class="portrait"
      />
      <p class="lede">
        I experiment with infrastructure in my <a href="/projects/">homelab</a>: Kubernetes clusters, Terraform, Argo CD, observability, and ephemeral cloud deployments.
        It's where I solve the problems that matter to me, the way I think they should be solved, and where I'm not afraid to break things to find out what actually works.
        This site is where I write up those problems and the solutions that stick.
      </p>
      <nav class="social" aria-label="Social links">
        {
          socialLinks.map(({ label, href, icon }) => (
            <a href={href}>
              {icon && <SocialIcon name={icon} />}
              {label} ↗
            </a>
          ))
        }
        <a href="/rss.xml"><SocialIcon name="rss" />RSS ↗</a>
      </nav>
    </section>

    <section class="writing fade-up" style="--fade-delay: .15s">
      <div class="writing-head">
        <h2 class="section-label">Recent writing</h2>
        <a href="/writing/" class="all-posts">All posts →</a>
      </div>
      <div class="post-list">
        {
          recentPosts.map((post) => (
            <a href={`/writing/${post.id}/`} class="post-row">
              <span class="post-title">{post.data.title}</span>
              <span class="post-date">
                {dateFormatter.format(post.data.publishDate)}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    max-width: 660px;
    margin: 0 auto;
    padding: 88px 32px 120px;
  }

  /* Two-column grid: text left, portrait right. The portrait sits in the
     headline's row so their tops align (the kicker row stays text-only);
     on mobile the grid collapses and the markup order — headline, portrait,
     lede — reads top to bottom. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 40px;
    align-items: start;
  }

  .intro > :not(.portrait) {
    grid-column: 1;
  }

  .portrait {
    grid-column: 2;
    grid-row: 2 / span 3;
    width: 148px;
    height: 148px;
    border-radius: 50%;
    border: 1px solid var(--border2);
  }

  .kicker {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 13px;
    color: var(--accent);
    margin: 0 0 20px;
  }

  .headline {
    font-size: 38px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.022em;
    color: var(--strong);
    margin: 0 0 22px;
    text-wrap: balance;
  }

  /* Justified with automatic hyphenation: the lede shares its row with the
     portrait, so the measure is narrow enough that justification alone would
     open rivers of whitespace. Hyphenation (English patterns, via the
     `lang="en"` on <html>) keeps the inter-word spacing even. The limits stop
     the browser from breaking short words or leaving one- or two-letter
     fragments dangling at a line edge. */
  .lede {
    font-size: 17px;
    line-height: 1.75;
    margin: 0 0 16px;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
    hyphenate-limit-chars: 7 4 3;
  }

  .lede:last-of-type {
    margin-bottom: 0;
  }

  .lede strong {
    color: var(--strong);
    font-weight: 600;
  }

  .social {
    display: flex;
    gap: 18px;
    margin-top: 30px;
    font-size: 14px;
  }

  /* Icon, label and the ↗ affordance sit on one baseline-ish row; the icon is
     nudged down slightly because its 256-grid glyphs read high against text. */
  .social a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    text-decoration: none;
  }

  .social a svg {
    flex: none;
    translate: 0 1px;
  }

  .writing {
    margin-top: 88px;
  }

  .writing-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .all-posts {
    font-size: 13.5px;
    color: var(--muted);
    text-decoration: none;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: flex;
    align-items: baseline;
    gap: 20px;
    text-decoration: none;
    padding: 16px 0;
    border-bottom: 1px solid var(--border2);
    transition: background-color 0.15s;
  }

  .post-row:hover {
    background: var(--tint);
  }

  .post-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--strong);
    flex: 1;
    line-height: 1.4;
  }

  .post-date {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12.5px;
    color: var(--faint);
    flex: none;
  }

  @media (max-width: 760px) {
    .home {
      padding: 56px 20px 88px;
    }
    .headline {
      font-size: 29px;
    }
    .intro {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      grid-column: 1;
      grid-row: auto;
      justify-self: center;
      width: 128px;
      height: 128px;
      margin: 8px 0 28px;
    }
    .post-row {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
