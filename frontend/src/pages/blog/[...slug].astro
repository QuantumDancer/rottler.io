---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, type BlogPost } from '../../lib/posts';

// Build one page per published post. Because getPublishedPosts() drops drafts
// in production, draft posts get no path here and never appear in `dist/`.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Posts are newest-first, so the neighbour toward index 0 is newer.
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}

interface Props {
  post: BlogPost;
  newer?: BlogPost;
  older?: BlogPost;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} | Benjamin Rottler`} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.publishDate.toISOString()}>
          {dateFormatter.format(post.data.publishDate)}
        </time>
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="post-tags">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <Content />
  </article>

  <nav class="post-nav" aria-label="Post navigation">
    {older && <a class="post-nav-prev" href={`/blog/${older.id}/`}>← {older.data.title}</a>}
    {newer && <a class="post-nav-next" href={`/blog/${newer.id}/`}>{newer.data.title} →</a>}
  </nav>
</BaseLayout>
