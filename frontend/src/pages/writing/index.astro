---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();

// Short month + zero-padded day, e.g. "Jun 14" — matches the design's row date.
const rowDateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: '2-digit',
});

// Posts already arrive newest-first, so first-seen year is the newest year and
// Map insertion order gives us newest-year-first groups with no extra sort.
const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.publishDate.getFullYear();
  const group = postsByYear.get(year) ?? [];
  group.push(post);
  postsByYear.set(year, group);
}
const yearGroups = [...postsByYear.entries()].map(([year, yearPosts]) => ({
  year,
  posts: yearPosts.map((post) => ({
    id: post.id,
    title: post.data.title,
    date: rowDateFormatter.format(post.data.publishDate),
    tagline: post.data.tags.join(' · '),
    // One lowercase haystack per row so the client filter is a plain substring
    // test over both the title and the tags.
    searchIndex: [post.data.title, ...post.data.tags].join(' ').toLowerCase(),
  })),
}));

const countLabel = (n: number) => `${n} post${n === 1 ? '' : 's'}`;
---

<BaseLayout title="Writing | Benjamin Rottler">
  <div class="writing">
    <div class="writing-intro fade-up">
      <h1 class="writing-title">Writing</h1>
      <p class="writing-lede">
        Problems I ran into building infrastructure in my homelab and the solutions that stuck.
      </p>
      <div class="writing-search">
        <span class="writing-search-icon" aria-hidden="true">⌕</span>
        <input
          type="search"
          class="writing-search-input"
          placeholder="Search posts by title or tag…"
          aria-label="Search posts by title or tag"
          data-writing-search
        />
        <span class="writing-search-count" data-writing-count>
          {countLabel(posts.length)}
        </span>
      </div>
    </div>

    <div class="writing-list fade-up" style="--fade-delay:0.12s">
      {
        yearGroups.map((group) => (
          <div class="year-group" data-year-group>
            <div class="year-label">{group.year}</div>
            <div class="year-posts">
              {group.posts.map((post) => (
                <a
                  href={`/writing/${post.id}/`}
                  class="post-row"
                  data-post
                  data-search={post.searchIndex}
                >
                  <span class="post-dot" aria-hidden="true" />
                  <span class="post-head">
                    <span class="post-title">{post.title}</span>
                    <span class="post-date">{post.date}</span>
                  </span>
                  {post.tagline && <span class="post-tags">{post.tagline}</span>}
                </a>
              ))}
            </div>
          </div>
        ))
      }
      <p class="writing-empty" data-writing-empty hidden>
        No posts match “<span data-writing-empty-query></span>”.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .writing {
    max-width: 660px;
    margin: 0 auto;
    padding: 72px 32px 120px;
  }

  .writing-title {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.022em;
    color: var(--strong);
    margin: 0 0 10px;
  }

  .writing-lede {
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 32px;
  }

  .writing-search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border2);
    border-radius: 9px;
    padding: 11px 14px;
    margin-bottom: 56px;
  }

  .writing-search-icon {
    color: var(--faint);
    font-size: 14px;
  }

  .writing-search-input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: inherit;
    font-size: 14.5px;
    padding: 0;
  }

  .writing-search-input::placeholder {
    color: var(--faint);
  }

  .writing-search-count {
    flex: none;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12px;
    color: var(--faint);
  }

  .year-group {
    display: flex;
    gap: 32px;
    margin-bottom: 12px;
  }

  .year-label {
    flex: none;
    width: 52px;
    padding-top: 14px;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 14px;
    font-weight: 600;
    color: var(--faint);
  }

  .year-posts {
    flex: 1;
    min-width: 0;
    border-left: 1px solid var(--border2);
    padding-bottom: 28px;
  }

  .post-row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 0 14px 28px;
    text-decoration: none;
    transition: background-color 0.15s;
  }

  .post-row:hover {
    background: var(--tint);
  }

  /* Sits on the year-posts border-left; the --bg ring punches it out of the line. */
  .post-dot {
    position: absolute;
    left: -4px;
    top: 22px;
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: var(--faint);
    border: 2px solid var(--bg);
  }

  .post-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .post-title {
    flex: 1;
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--strong);
  }

  .post-date {
    flex: none;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12px;
    color: var(--faint);
  }

  .post-tags {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 11.5px;
    color: var(--muted);
  }

  .writing-empty {
    padding-left: 84px;
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .writing {
      padding: 48px 20px 88px;
    }
    .writing-title {
      font-size: 29px;
    }
    .year-group {
      flex-direction: column;
      gap: 6px;
    }
    .year-label {
      width: auto;
      padding-top: 0;
    }
  }
</style>

<script>
  // Progressive enhancement: the full year-grouped list is server-rendered, so
  // it works without JS. This wires the search box to filter the existing DOM —
  // hiding non-matching rows, collapsing emptied year groups, and swapping the
  // count label / empty-state message to mirror the design's live behavior.
  const search = document.querySelector<HTMLInputElement>('[data-writing-search]');
  const count = document.querySelector<HTMLElement>('[data-writing-count]');
  const emptyMessage = document.querySelector<HTMLElement>('[data-writing-empty]');
  const emptyQuery = document.querySelector<HTMLElement>('[data-writing-empty-query]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const yearGroups = [...document.querySelectorAll<HTMLElement>('[data-year-group]')];

  if (search && count && emptyMessage && emptyQuery) {
    const total = rows.length;
    const postCount = (n: number) => `${n} post${n === 1 ? '' : 's'}`;

    const applyFilter = () => {
      const query = search.value.toLowerCase().trim();
      let visible = 0;

      for (const row of rows) {
        const matches = !query || (row.dataset.search ?? '').includes(query);
        row.hidden = !matches;
        if (matches) visible++;
      }

      for (const group of yearGroups) {
        group.hidden = !group.querySelector('[data-post]:not([hidden])');
      }

      count.textContent = query ? `${visible} / ${total}` : postCount(total);

      const noResults = visible === 0;
      emptyMessage.hidden = !noResults;
      if (noResults) emptyQuery.textContent = search.value.trim();
    };

    search.addEventListener('input', applyFilter);
  }
</script>
