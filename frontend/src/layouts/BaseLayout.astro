---
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site, navLinks } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;

const currentPath = Astro.url.pathname;
// A nav link is active for its whole section (e.g. /writing/ matches
// /writing/some-post/), except Home, which only matches exactly.
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash of the
      // wrong theme. Must stay inline and ahead of any stylesheet paint.
      (() => {
        try {
          const stored = localStorage.getItem('rottler-theme');
          if (stored === 'light') {
            document.documentElement.dataset.theme = 'light';
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <!-- Labelled explicitly because the narrow-viewport rules hide both text
           spans, leaving only the aria-hidden glyph as the link's content. -->
      <a href="/" class="site-brand" aria-label={site.name}>
        <!-- Same shell-prompt glyph as favicon.svg — keep the two in sync. -->
        <svg
          class="brand-glyph"
          viewBox="0 0 256 256"
          width="16"
          height="16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M117.31,134l-72,64a8,8,0,1,1-10.63-12L100,128,34.69,70A8,8,0,1,1,45.32,58l72,64a8,8,0,0,1,0,12ZM216,184H120a8,8,0,0,0,0,16h96a8,8,0,0,0,0-16Z"
          ></path>
        </svg>
        <span class="brand-name">{site.name}</span>
        <span class="brand-domain">rottler.io</span>
      </a>
      <div class="site-header-right">
        <nav class="site-nav" aria-label="Primary">
          {
            navLinks.map(({ label, href }) => (
              <a href={href} aria-current={isActive(href) ? 'page' : false}>
                {label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>
