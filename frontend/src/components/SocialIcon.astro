---
// Inline social glyphs, carried over from the legacy site so the links keep
// their familiar marks. Glyph data and the name union live in
// `social-icons.ts`; see there for why they are inlined rather than pulled
// from an icon package.
//
// Every icon inherits the surrounding text color via `currentColor`, so they
// follow the theme toggle and link hover states without extra styling.
import { socialIconPaths, type SocialIconName } from './social-icons';

interface Props {
  name: SocialIconName;
  /** Rendered size in px; 16 lines up with the 14px social link text. */
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

{
  /*
    The RSS mark is drawn as strokes (dot plus two arcs) instead of a filled
    path. The 20px stroke width on the 256 grid matches the visual weight of
    the filled Phosphor glyphs next to it.
  */
}
{
  name === 'rss' ? (
    <svg
      width={size}
      height={size}
      viewBox="0 0 256 256"
      fill="none"
      stroke="currentColor"
      stroke-width="20"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="68" cy="188" r="14" fill="currentColor" stroke="none" />
      <path d="M56,120a80,80,0,0,1,80,80" />
      <path d="M56,64A136,136,0,0,1,192,200" />
    </svg>
  ) : (
    <svg
      width={size}
      height={size}
      viewBox="0 0 256 256"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <path d={socialIconPaths[name]} />
    </svg>
  )
}
